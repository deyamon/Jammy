# Backend
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROOM_STORE=memory
RECONNECT_GRACE_MS=30000
# Voice chat uses public STUN by default. Set TURN values from your deployment's TURN provider when needed.
VOICE_STUN_URLS=stun:stun.l.google.com:19302
# VOICE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# VOICE_TURN_USERNAME=temporary-user
# VOICE_TURN_CREDENTIAL=temporary-credential
# Create a key in Google Cloud and enable YouTube Data API v3. Keep this server-only.
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY

# Frontend API and Socket.IO URL
VITE_API_URL=http://localhost:3001
# Neon Auth URL from the same Neon branch. This public endpoint is passed to the frontend by vite.config.js.
# Neon CLI may place this in .env.local; the backend and Vite both load .env.local and .env.
# Copy the full Managed Auth base URL from the intended Neon branch; keep its database/auth path.
NEON_AUTH_BASE_URL=https://ep-YOUR_BRANCH_ID.neonauth.YOUR_REGION.aws.neon.tech/neondb/auth
# Server-only JWT verification settings. Never add secrets or database URLs to VITE_* variables.
NEON_AUTH_JWKS_URL=https://ep-YOUR_BRANCH_ID.neonauth.YOUR_REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Defaults to the origin of NEON_AUTH_BASE_URL (without /neondb/auth). Override only with the exact documented JWT issuer.
# NEON_AUTH_ISSUER=https://YOUR_NEON_AUTH_ISSUER
# Optional audience constraint. Set only to the audience issued for Jammy by this Neon Auth branch.
# NEON_AUTH_AUDIENCE=YOUR_DOCUMENTED_JWT_AUDIENCE

# Set DATABASE_URL to enable account authentication. Neon app connections may use the pooled URL.
# Use sslmode=require (or verify-full) with Neon; never commit real connection strings.
# For Neon migrations, set DATABASE_URL_UNPOOLED to the direct URL (hostname without -pooler).
# Also set ROOM_STORE=postgres to persist rooms. Startup never applies schema changes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional Spotify Web API integration. Get the client ID and secret from Spotify Developer Dashboard > your app > Settings.
# Register SPOTIFY_REDIRECT_URI exactly under Redirect URIs. Keep every value server-side; do not use VITE_ prefixes.
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback
# Base64 encoding of 32 random bytes. Generate a unique key per deployment with:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
SPOTIFY_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

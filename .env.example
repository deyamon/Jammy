# Backend
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROOM_STORE=memory
RECONNECT_GRACE_MS=30000
# Create a key in Google Cloud and enable YouTube Data API v3. Keep this server-only.
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY

# Optional Spotify Web API track search (server-only Client Credentials flow).
# Spotify embeds are served by Spotify and do not use these values.
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_APP_CLIENT_ID
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_APP_CLIENT_SECRET

# Frontend API and Socket.IO URL
VITE_API_URL=http://localhost:3001

# Optional authorized local audio demo. Put the file in public/audio/ and use its public URL.
VITE_JAMMY_DEMO_AUDIO_URL=/audio/demo-audio.mp3

# Set ROOM_STORE=postgres and replace the placeholder with a PostgreSQL URL.
# Keep sslmode=require for Neon. The backend applies server/schema.sql at startup.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
